# Copy to .env to override defaults. All settings are optional.
# Where cached prices and the SQLite database live.
BTM_DATA_DIR=data
# Any SQLAlchemy URL. For the later hosted copy, a free Postgres URL goes here.
BTM_DATABASE_URL=sqlite:///data/btm.db
# Price data source. Only "yahoo" for now.
BTM_PRICE_PROVIDER=yahoo
